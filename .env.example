# Copy this file to .env and fill only the providers you use.

# Optional provider selector. CLI --provider still takes precedence.
CODEFLOW_PROVIDER=deepseek

# Recommended default. DeepSeek uses its Anthropic-compatible endpoint.
CODEFLOW_DEEPSEEK_API_BASE=https://api.deepseek.com/anthropic
CODEFLOW_DEEPSEEK_API_KEY=
CODEFLOW_DEEPSEEK_MODEL=deepseek-v4-pro

# Optional right.codes shared key. Still supported when you override the OpenAI or Anthropic base URL.
CODEFLOW_RIGHT_CODES_API_KEY=

# OpenAI provider path. This uses DeepSeek's OpenAI-compatible Responses API and reuses
# CODEFLOW_DEEPSEEK_API_KEY when CODEFLOW_OPENAI_API_KEY is empty.
CODEFLOW_OPENAI_API_BASE=https://api.deepseek.com
CODEFLOW_OPENAI_API_KEY=
CODEFLOW_OPENAI_MODEL=deepseek-v4-flash

# Default Anthropic-compatible endpoint. Can reuse CODEFLOW_RIGHT_CODES_API_KEY when your gateway shares one key.
CODEFLOW_ANTHROPIC_API_BASE=https://www.right.codes/claude/v1
CODEFLOW_ANTHROPIC_API_KEY=
CODEFLOW_ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional comma-separated extra env names to redact from traces and reports.
CODEFLOW_SECRET_ENV_NAMES=

# Local Chinese semantic retrieval model; downloaded on first use and cached by FastEmbed.
CODEFLOW_MEMORY_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
